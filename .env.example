# Optional server-side ACE Music credentials.
# Prefer the in-app Settings page for personal keys (stored only in the browser).
# Use these only when hosting a protected deployment that should inject a key.

# Official cloud API: https://api.acemusic.ai
# Local ACE-Step native API: http://127.0.0.1:8001
# Local OpenRouter-compatible API: http://127.0.0.1:8002
ACE_API_BASE_URL=https://api.acemusic.ai

# Never commit a real key. Get one at https://acemusic.ai/playground/api-key
ACE_MUSIC_API_KEY=

# Optional Spline Viewer scene URL (must be a .splinecode export, not a community page).
# VITE_SPLINE_SCENE_URL=https://prod.spline.design/your-export-id/scene.splinecode

PORT=4173
HOST=0.0.0.0
